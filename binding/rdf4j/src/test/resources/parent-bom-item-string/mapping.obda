[PrefixDeclaration]
: http://example.org/ontology#
xsd: http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[
mappingId	classMapping
target		:bom_item/{id} a :bom_item ; :bom_item_id {bom_item_id}^^xsd:string ; :material_code {material_code}^^xsd:string ; :parent_material_code {parent_material_code}^^xsd:string ; :bom_version {bom_version}^^xsd:string .
source		select bom_item_id as id, bom_item_id, material_code, parent_material_code, bom_version from parent_bom

mappingId	parentBomItem
target		:bom_item/{src_key} :parent_bom_item :bom_item/{dst_key} .
source		SELECT s.bom_item_id AS src_key, d.bom_item_id AS dst_key FROM parent_bom s INNER JOIN parent_bom d ON s.parent_material_code = d.material_code

mappingId	hasComponent
target		:bom_item/{bom_item_id} :has_component :material/{material_code} .
source		SELECT b.bom_item_id AS bom_item_id, m.material_code AS material_code FROM parent_bom b INNER JOIN material m ON b.material_code = m.material_code

mappingId	materialClass
target		:material/{material_code} a :material ; :material_code {material_code}^^xsd:string ; :material_name {material_name}^^xsd:string .
source		select material_code, material_name from material
]]
