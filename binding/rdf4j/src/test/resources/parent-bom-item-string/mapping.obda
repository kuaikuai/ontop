[PrefixDeclaration]
: http://example.org/ontology#
xsd: http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[
mappingId	classMapping
target		:bom_item/{id} a :bom_item ; :bom_item_id {bom_item_id}^^xsd:string ; :bom_code {bom_code}^^xsd:string ; :material_code {material_code}^^xsd:string ; :parent_material_code {parent_material_code}^^xsd:string ; :bom_version {bom_version}^^xsd:string ; :unit {unit}^^xsd:string ; :process_code {process_code}^^xsd:string ; :quantity {quantity}^^xsd:string ; :parent_base_qty {parent_base_qty}^^xsd:string .
source		select bom_item_id as id, bom_item_id, material_code as bom_code, material_code, parent_material_code, bom_version, material_code as unit, material_code as process_code, bom_item_id as quantity, bom_item_id as parent_base_qty from parent_bom

mappingId	parentBomItem
target		:bom_item/{src_key} :parent_bom_item :bom_item/{dst_key} .
source		SELECT s.bom_item_id AS src_key, d.bom_item_id AS dst_key FROM parent_bom s INNER JOIN parent_bom d ON s.parent_material_code = d.material_code

mappingId	hasComponent
target		:bom_item/{src_key} :has_component :material/{dst_key} .
source		SELECT s.bom_item_id AS src_key, d.id AS dst_key FROM parent_bom s INNER JOIN material d ON s.material_code = d.material_code

mappingId	materialClass
target		:material/{id} a :material ; :material_code {material_code}^^xsd:string ; :material_name {material_name}^^xsd:string ; :color {color}^^xsd:string ; :category_code {category_code}^^xsd:string ; :safety_stock {safety_stock}^^xsd:string ; :is_critical {is_critical}^^xsd:string ; :procurement_type {procurement_type}^^xsd:string ; :spec_width {spec_width}^^xsd:string ; :spec_length {spec_length}^^xsd:string ; :plant_code {plant_code}^^xsd:string ; :base_unit {base_unit}^^xsd:string ; :spec_thickness {spec_thickness}^^xsd:string ; :density {density}^^xsd:string ; :material_type {material_type}^^xsd:string ; :material_desc {material_desc}^^xsd:string .
source		select id, material_code, material_name, color, category_code, safety_stock, is_critical, procurement_type, spec_width, spec_length, plant_code, base_unit, spec_thickness, density, material_type, material_desc from material
]]
