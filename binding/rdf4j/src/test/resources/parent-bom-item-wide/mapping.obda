[PrefixDeclaration]
: http://example.org/ontology#
xsd: http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[
mappingId	classMapping
target		:bom_item/{id} a :bom_item ; :bom_item_id {bom_item_id} ; :material_code {material_code} ; :bom_code {bom_code} ; :unit {unit} ; :process_code {process_code} ; :bom_version {bom_version} ; :quantity {quantity} ; :parent_base_qty {parent_base_qty} ; :parent_material_code {parent_material_code} .
source		select bom_item_id as id, bom_item_id, material_code, bom_code, unit, process_code, bom_version, quantity, parent_base_qty, parent_material_code from parent_bom

mappingId	parentBomItem
target		:bom_item/{src_key} :parent_bom_item :bom_item/{dst_key} .
source		SELECT s.bom_item_id AS src_key, d.bom_item_id AS dst_key FROM parent_bom s INNER JOIN parent_bom d ON s.parent_material_code = d.material_code

mappingId	hasComponent
target		:bom_item/{src_key} :has_component :material/{id} .
source		SELECT b.bom_item_id AS src_key, m.id FROM parent_bom b INNER JOIN material m ON b.material_code = m.material_code

mappingId	materialClass
target		:material/{id} a :material ; :material_code {material_code} ; :material_name {material_name} ; :color {color} ; :category_code {category_code} ; :safety_stock {safety_stock} ; :is_critical {is_critical} ; :procurement_type {procurement_type} ; :spec_width {spec_width} ; :spec_length {spec_length} ; :plant_code {plant_code} ; :base_unit {base_unit} .
source		select id, material_code, material_name, color, category_code, safety_stock, is_critical, procurement_type, spec_width, spec_length, plant_code, base_unit from material
]]
