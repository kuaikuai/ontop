[PrefixDeclaration]
: http://example.org/ontology#

[MappingDeclaration] @collection [[
mappingId	classMapping
target		:bom_item/{id} a :bom_item ; :bom_item_id {bom_item_id} ; :material_code {material_code} ; :parent_material_code {parent_material_code} ; :bom_version {bom_version}^^xsd:integer .
source		select bom_item_id as id, bom_item_id, material_code, parent_material_code, bom_version from parent_bom

mappingId	parentBomItem
target		:bom_item/{src_key} :parent_bom_item :bom_item/{dst_key} .
source		SELECT s.bom_item_id AS src_key, d.bom_item_id AS dst_key FROM parent_bom s INNER JOIN parent_bom d ON s.parent_material_code = d.material_code
]]
